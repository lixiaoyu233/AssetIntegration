{
  "name": "wealthcard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WealthCard — 本地纯前端资产归集表与再平衡工具（暗黑模式 / localStorage 持久化 / 基金实时估值）",
  "scripts": {
    "dev": "vite",
